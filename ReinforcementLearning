"""
Reinforcement Learning — best for sequential optimization
Use when: the system takes actions, receives feedback, and improves a policy.
Best for:
Energy optimization
Robotic control
Production scheduling
Dynamic pricing
Routing
Autonomous systems
Simple example: optimize cooling setpoint to reduce energy while avoiding high temperature.

Real-life fit: use RL when the model must decide actions over time, not just predict an outcome.
"""


import gymnasium as gym
from gymnasium import spaces
import numpy as np
from stable_baselines3 import PPO

class EnergyControlEnv(gym.Env):
    def __init__(self):
        super().__init__()

        # Observation: [current_temp, outside_temp, energy_price]
        self.observation_space = spaces.Box(
            low=np.array([50, 0, 0]),
            high=np.array([100, 120, 1]),
            dtype=np.float32
        )

        # Actions: 0 = reduce cooling, 1 = maintain, 2 = increase cooling
        self.action_space = spaces.Discrete(3)

        self.current_temp = 75
        self.outside_temp = 95
        self.energy_price = 0.2

    def reset(self, seed=None, options=None):
        self.current_temp = 75
        self.outside_temp = np.random.uniform(80, 105)
        self.energy_price = np.random.uniform(0.1, 0.5)
        return self._get_obs(), {}

    def step(self, action):
        cooling_power = action - 1  # -1, 0, +1

        self.current_temp += 0.2 * (self.outside_temp - self.current_temp)
        self.current_temp -= cooling_power * 2

        energy_cost = max(cooling_power, 0) * self.energy_price * 10
        comfort_penalty = abs(self.current_temp - 72)

        reward = -(energy_cost + comfort_penalty)

        terminated = False
        truncated = False

        return self._get_obs(), reward, terminated, truncated, {}

    def _get_obs(self):
        return np.array(
            [self.current_temp, self.outside_temp, self.energy_price],
            dtype=np.float32
        )

env = EnergyControlEnv()
model = PPO("MlpPolicy", env, verbose=1)
model.learn(total_timesteps=10_000)